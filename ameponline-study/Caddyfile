http://LWA.spiritwave.dpdns.org {
	bind 127.0.0.1
	forward_auth 127.0.0.1:18081 {
		uri /api/auth/check
	}
	header X-Robots-Tag "noindex, nofollow"
	reverse_proxy 127.0.0.1:18080
}

http://study.spiritwave.dpdns.org {
	bind 127.0.0.1
	@public path /login /register /forgot /auth.css /auth.js /style.css /app.js /api/auth/*
	handle @public {
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy 127.0.0.1:18081
	}
	handle {
		forward_auth 127.0.0.1:18081 {
			uri /api/auth/check
		}
		header X-Robots-Tag "noindex, nofollow"
		reverse_proxy 127.0.0.1:18081
	}
}
